{
  "application": {
    "baseUrl": "http://localhost:3000"
  },
  "run": {
    "projectId": "",
    "artifactRoot": "artifacts/"
  },
  "api": {
    "enabled": false,
    "baseUrl": "http://localhost:8080",
    "apiKeyEnv": "COVERIT_API_KEY",
    "eventPath": "/api/v1/regression/runs/{runId}/events",
    "completionPath": "/api/v1/regression/runs/{runId}/complete"
  },
  "reporting": {
    "localArtifactsEnabled": true
  },
  "healing": {
    "enabled": true,
    "threshold": 0.55,
    "artifactPath": "artifacts/self-healing/healing-events.jsonl"
  }
}
