import fs from "fs";
import path from "path";

import { ApiReportingConfig, CoveritConfig } from "@/types";

type CoveritConfigFile = Omit<CoveritConfig, "apiReporting">;

export function loadCoveritConfig(configPath = "coverit.config.json"): CoveritConfig {
  const absolutePath = path.resolve(configPath);
  if (!fs.existsSync(absolutePath)) {
    throw new Error(`CoverIt config was not found at "${absolutePath}". Generate or restore coverit.config.json.`);
  }

  try {
    loadDotEnv(path.join(path.dirname(absolutePath), ".env"));
    return resolveConfig(JSON.parse(fs.readFileSync(absolutePath, "utf8")) as CoveritConfigFile);
  } catch (error) {
    throw new Error(`CoverIt config at "${absolutePath}" is invalid: ${(error as Error).message}`);
  }
}

export function getCoveritRunId(): string {
  const existing = process.env.COVERIT_RUN_ID;
  if (existing) return existing;
  const timestamp = new Date().toISOString().replace(/[-:]/g, "").replace(/\..+$/, "").replace("T", "-");
  const suffix = Math.random().toString(36).slice(2, 8);
  const generated = `run-${timestamp}-${suffix}`;
  process.env.COVERIT_RUN_ID = generated;
  return generated;
}

function resolveConfig(config: CoveritConfigFile): CoveritConfig {
  if (!config.application?.baseUrl) throw new Error("coverit.config.json must define application.baseUrl.");
  if (!config.reporting) throw new Error("coverit.config.json must define reporting settings.");
  if (!config.reporting.artifactRoot) throw new Error("coverit.config.json must define reporting.artifactRoot.");
  if (!config.healing) throw new Error("coverit.config.json must define healing settings.");
  const run = { ...config.run, name: config.run?.name?.trim() || "Run", applicationId: config.run?.applicationId || "", versionId: config.run?.versionId || undefined };
  return {
    ...config,
    run,
    apiReporting: resolveApiReporting(run.applicationId),
  };
}

function resolveApiReporting(applicationId: string): ApiReportingConfig {
  const requested = parseBooleanEnv("COVERIT_API_REPORTING_ENABLED");
  const baseUrl = (trimEnv("COVERIT_API_BASE_URL") ?? "").replace(/\/+$/, "");
  const apiKey = trimEnv("COVERIT_API_KEY");
  const disabledReason = apiDisabledReasonFor({ requested, applicationId, baseUrl, apiKey });
  return {
    enabled: Boolean(requested && !disabledReason),
    baseUrl,
    apiKey,
    disabledReason,
  };
}

function apiDisabledReasonFor(input: { requested: boolean; applicationId: string; baseUrl: string; apiKey?: string }): string | undefined {
  const { requested, applicationId, baseUrl, apiKey } = input;
  if (!requested) {
    return "API reporting disabled: set COVERIT_API_REPORTING_ENABLED=true in the environment to enable CoverIt API sending.";
  }
  if (!applicationId) {
    return "API reporting disabled: coverit.config.json is missing run.applicationId. Set it to the target application id from CoverIt.";
  }
  if (!baseUrl) {
    return "API reporting disabled: set COVERIT_API_BASE_URL.";
  }
  if (!apiKey) {
    return "API reporting disabled: COVERIT_API_KEY is not set. Store it in .env locally or as a GitHub Actions secret.";
  }
  return undefined;
}

function loadDotEnv(filePath: string): void {
  if (!fs.existsSync(filePath)) return;
  for (const line of fs.readFileSync(filePath, "utf8").split(/\r?\n/)) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith("#")) continue;
    const separatorIndex = trimmed.indexOf("=");
    if (separatorIndex <= 0) continue;
    const key = trimmed.slice(0, separatorIndex).trim();
    const value = unquoteEnvValue(trimmed.slice(separatorIndex + 1).trim());
    if (key && process.env[key] === undefined) process.env[key] = value;
  }
}

function unquoteEnvValue(value: string): string {
  const quote = value[0];
  if ((quote === "\"" || quote === "'") && value.endsWith(quote)) return value.slice(1, -1);
  return value;
}

function trimEnv(name: string): string | undefined {
  const value = process.env[name]?.trim();
  return value ? value : undefined;
}

function parseBooleanEnv(name: string): boolean {
  return ["1", "true", "yes", "on"].includes(process.env[name]?.trim().toLowerCase() ?? "");
}
