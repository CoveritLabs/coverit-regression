import type { RunReporter } from "@/reporting/runReporter";
import type { AssertionSeverity } from "@/types/assertion";

export interface RegressionRunnerOptions {
  runOrigin?: string;
  featureName?: string;
  scenarioName?: string;
  reporter?: RunReporter;
}

export interface HealingInfo {
  wasHealed: boolean;
  originalSelector: string;
  healedSelector?: string;
  score?: number;
  reason?: string;
  breakdown?: Record<string, number>;
}

export interface HealingContext {
  featureName?: string;
  scenarioName?: string;
  stepType: string;
  stepId: string;
  stepLabel: string;
  action?: string;
  stateId?: string;
  locatorKey?: string;
}

export interface HealingCandidate {
  selector: string;
  tagName: string;
  id: string;
  classes: string[];
  text: string;
  attributes: Record<string, string>;
  dataAttributes: Record<string, string>;
  ariaLabel: string;
  role: string;
  name: string;
  placeholder: string;
  type: string;
  parentText: string;
  siblingText: string;
  visible: boolean;
  childElementCount: number;
}

export interface HealingResult {
  healed: boolean;
  originalSelector: string;
  healedSelector?: string;
  score?: number;
  reason?: string;
  breakdown?: Record<string, number>;
  context?: HealingContext;
  timestamp?: string;
  message: string;
}

export interface AssertionResult {
  name: string;
  passed: boolean;
  severity: AssertionSeverity;
  message: string;
  details?: string;
  healingInfo?: HealingInfo;
}
