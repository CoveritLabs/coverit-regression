export interface StateInfo {
  id: string;
  label: string;
  url: string;
  className: string;
  baselineDir: string;
  snapshotPath?: string;
  dom?: StateDomInfo;
  overwritable?: boolean;
}

export interface StateDomInfo {
  root?: LocatorInfo;
  landmarks?: Record<string, LocatorInfo>;
  elements?: Record<string, LocatorInfo>;
}

export interface LocatorInfo {
  id?: string;
  className?: string;
  cssSelector?: string;
  xpath?: string;
  text?: string;
  role?: string;
  testId?: string;
}

export interface StateLocatorMap {
  overwritable?: boolean;
  [locatorKey: string]: LocatorInfo | boolean | undefined;
}

export interface GeneratedStateDefinition extends StateInfo {}
