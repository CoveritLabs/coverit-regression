import type { HookTiming } from "@/types/actionHook";

export type BddKeyword = "Given" | "When" | "Then" | "And" | "But";
export type RuntimeStepType = "STATE" | "TRANSITION" | "ASSERTION" | "ACTION_HOOK";

export interface RuntimeStepPlan {
  type: RuntimeStepType;
  id: string;
  keyword: BddKeyword;
  rawText: string;
  hookTiming?: HookTiming;
  parentId?: string;
  contextId?: string;
}

export interface RuntimeScenarioPlan {
  name: string;
  marks?: string[];
  designClassId?: string;
  designClassStep?: {
    type: "DESIGN_CLASS";
    id: string;
    keyword: BddKeyword;
    rawText: string;
  };
  steps: RuntimeStepPlan[];
}

export interface RuntimeFeaturePlan {
  name: string;
  filePath: string;
  marks?: string[];
  scenarios: RuntimeScenarioPlan[];
}
