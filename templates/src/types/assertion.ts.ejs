export type AssertionSeverity = "blocking" | "warning" | "info";

export interface AssertionElementInfo {
  stateId: string;
  locatorKey: string;
  attribute?: string;
}

export interface UserAssertionFunctionDefinition {
  implementationId?: string;
  severity?: AssertionSeverity;
  description?: string;
}

export interface AssertionInfo {
  elements?: Record<string, AssertionElementInfo>;
  functions?: Record<string, UserAssertionFunctionDefinition>;
  overwritable?: boolean;
}
