import { getCoveritRunId, loadCoveritConfig } from "@/config/coveritConfig";
import { CoveritApiClient } from "@/reporting/coveritApiClient";
import { LocalArtifactStore } from "@/reporting/localArtifactStore";
import { AssertionResult, RegressionEvent, RunIdentity, RunSummary, ScenarioStatus, StepReport, StepStatus } from "@/types";
import { getArtifactPaths } from "@/utils/artifactPaths";
import { logger, Logger } from "@/utils/logger";
import type { Page } from "@playwright/test";

export class RunReporter {
  private static readonly warnedApiDisabledReasons = new Set<string>();
  private static readonly uploadedArtifactPaths = new Set<string>();
  private static readonly scenarioArtifactMappings = new Map<string, { featureName?: string; scenarioName?: string; scenarioArtifactName: string }>();
  private readonly apiClient?: CoveritApiClient;
  private readonly artifactStore?: LocalArtifactStore;
  private readonly identity: RunIdentity;
  private readonly logger: Logger;
  private scenarioStartedAt?: string;

  constructor(identity: Partial<RunIdentity> = {}, config?: ReturnType<typeof loadCoveritConfig>) {
    config = config ?? this.loadConfigOrFallback();
    const runId = identity.runId ?? getCoveritRunId();
    try {
      logger.configure({ logFilePath: getArtifactPaths(config, runId).runLog });
    } catch (error) {
      logger.warn("Artifacts", `Could not configure run log. ${(error as Error).message}`);
    }
    this.apiClient = this.createApiClient(config);
    this.artifactStore = this.createArtifactStore(config, runId);
    const scenarioLogPath = this.getScenarioLogPath(identity);
    this.logger = logger.forScenario({ logFilePath: scenarioLogPath });
    if (config.apiReporting.disabledReason && !RunReporter.warnedApiDisabledReasons.has(config.apiReporting.disabledReason)) {
      RunReporter.warnedApiDisabledReasons.add(config.apiReporting.disabledReason);
      logger.warn("CoverIt API", config.apiReporting.disabledReason);
    }
    this.identity = {
      runId,
      runName: config.run.name,
      applicationId: config.run.applicationId,
      ...(config.run.versionId ? { versionId: config.run.versionId } : {}),
      ...identity,
    };
    if (this.identity.scenarioName) {
      RunReporter.scenarioArtifactMappings.set(`${this.identity.featureName ?? ""}::${this.identity.scenarioName}::${this.identity.scenarioIndex ?? ""}`, {
        featureName: this.identity.featureName,
        scenarioName: this.identity.scenarioName,
        scenarioArtifactName: this.identity.scenarioArtifactName ?? this.identity.scenarioName,
      });
    }
  }

  async scenarioStatus(status: ScenarioStatus, context: { designClassId?: string; designClassStep?: { keyword?: string; rawText?: string } } = {}): Promise<void> {
    const timestamp = new Date().toISOString();
    if (status === "running" || !this.scenarioStartedAt) this.scenarioStartedAt = timestamp;
    const timing = status === "running"
      ? { startedAt: this.scenarioStartedAt }
      : {
        startedAt: this.scenarioStartedAt,
        finishedAt: timestamp,
        durationMs: Math.max(0, new Date(timestamp).getTime() - new Date(this.scenarioStartedAt).getTime()),
      };
    const designClassPayload = context.designClassId ? {
      designClassId: context.designClassId,
      ...(context.designClassStep ? {
        designClassStepText: context.designClassStep.rawText,
        designClassStepKeyword: context.designClassStep.keyword,
        bddStep: {
          type: "DESIGN_CLASS",
          id: context.designClassId,
          keyword: context.designClassStep.keyword,
          text: context.designClassStep.rawText,
        },
      } : {}),
    } : {};
    this.safeLocalArtifact("save scenario info", () => {
      this.artifactStore?.saveScenarioInfo({
        featureName: this.identity.featureName,
        scenarioName: this.identity.scenarioName,
        scenarioIndex: this.identity.scenarioIndex,
        scenarioArtifactName: this.identity.scenarioArtifactName,
        status,
        ...timing,
      });
    });
    await this.event("scenario.status", { status, ...timing, ...designClassPayload });
  }

  async stepStatus(report: Pick<StepReport, "id" | "label" | "stepType" | "stepText" | "stepKeyword">, status: StepStatus): Promise<void> {
    await this.event("step.status", {
      status,
      stepId: report.id,
      stepLabel: report.label,
      stepType: report.stepType,
      stepText: report.stepText,
      stepKeyword: report.stepKeyword,
      bddStep: {
        type: report.stepType,
        id: report.id,
        label: report.label,
        keyword: report.stepKeyword,
        text: report.stepText,
      },
    });
  }

  async assertionResult(report: Pick<StepReport, "id" | "label" | "stepType" | "stepText" | "stepKeyword">, result: AssertionResult): Promise<void> {
    const bddStep = result.bddStep ?? {
      type: report.stepType,
      id: report.id,
      label: report.label,
      keyword: report.stepKeyword,
      text: report.stepText,
    };
    const category = result.category ?? this.categoryForBddStepType(bddStep.type);
    await this.event("assertion.result", {
      category,
      title: this.titleForAssertionResult(category, result),
      stepId: bddStep.id,
      stepLabel: bddStep.label ?? report.label,
      stepType: bddStep.type,
      stepText: bddStep.text,
      stepKeyword: bddStep.keyword,
      parentStepId: report.id,
      parentStepLabel: report.label,
      parentStepType: report.stepType,
      parentStepText: report.stepText,
      parentStepKeyword: report.stepKeyword,
      bddStep,
      result,
    });
    if (!result.passed && result.severity === "blocking") await this.failure({ report, result });
  }

  async log(message: string, level: "info" | "warning" | "error" = "info"): Promise<void> {
    if (this.identity.scenarioName || this.identity.scenarioArtifactName || this.identity.scenarioIndex) this.safeLocalArtifact("append scenario log", () => {
      this.artifactStore?.appendScenarioLog({
        scenarioName: this.identity.scenarioName,
        scenarioIndex: this.identity.scenarioIndex,
        scenarioArtifactName: this.identity.scenarioArtifactName,
        level,
        message,
      });
    });
    await this.event("log", { level, message });
  }

  async failure(failure: unknown): Promise<void> {
    this.safeLocalArtifact("save failure", () => this.artifactStore?.saveFailure(failure));
    await this.event("failure", failure);
  }

  async saveSummary(summary: RunSummary): Promise<void> {
    this.safeLocalArtifact("save summary", () => this.artifactStore?.saveSummary(summary));
    await this.sendCompletion(summary);
  }

  async captureFailureArtifacts(page: Page, error: unknown): Promise<void> {
    if (!this.artifactStore) return;
    try {
      await this.artifactStore.savePlaywrightFailureArtifacts({
        featureName: this.identity.featureName,
        scenarioName: this.identity.scenarioName,
        scenarioIndex: this.identity.scenarioIndex,
        scenarioArtifactName: this.identity.scenarioArtifactName,
        error: error instanceof Error ? error : new Error(String(error)),
        screenshot: () => page.screenshot({ fullPage: true }),
      });
    } catch (artifactError) {
      this.logger.warn("Artifacts", `Could not capture failure artifacts. ${(artifactError as Error).message}`);
    }
  }

  async uploadArtifacts(scope: "all" | "run" | "scenario" = "all", options: { maxDurationMs?: number } = {}): Promise<void> {
    if (!this.apiClient || !this.artifactStore) return;
    let artifacts: ReturnType<LocalArtifactStore["listArtifacts"]> = [];
    try {
      artifacts = this.artifactStore.listArtifacts(scope, this.identity.scenarioIndex, this.identity.scenarioArtifactName, [...RunReporter.scenarioArtifactMappings.values()]);
    } catch (error) {
      this.logger.warn("Artifacts", `Could not list artifacts for upload. ${(error as Error).message}`);
      return;
    }
    if (artifacts.length === 0) return;

    const startedAt = Date.now();
    const maxDurationMs = options.maxDurationMs ?? 25_000;
    let uploaded = 0;
    let failed = 0;
    let skipped = 0;
    for (const artifact of artifacts) {
      const uploadKey = `${this.identity.runId}:${artifact.relativePath}`;
      if (RunReporter.uploadedArtifactPaths.has(uploadKey)) continue;
      if (Date.now() - startedAt > maxDurationMs) {
        skipped += 1;
        continue;
      }
      try {
        await this.apiClient.uploadArtifact(this.identity, artifact);
        RunReporter.uploadedArtifactPaths.add(uploadKey);
        uploaded += 1;
      } catch (error) {
        failed += 1;
        this.logger.warn("Artifacts", `Could not upload "${artifact.relativePath}". ${(error as Error).message}`);
      }
    }
    if (uploaded > 0 || failed > 0 || skipped > 0) this.logger.info("Artifacts", `Discovered ${artifacts.length} artifact(s); uploaded ${uploaded}; failed ${failed}; skipped ${skipped}.`);
  }

  private async event(type: string, payload: unknown): Promise<void> {
    const event: RegressionEvent = {
      id: `${Date.now()}-${Math.random().toString(16).slice(2)}`,
      type,
      timestamp: new Date().toISOString(),
      ...this.identity,
      payload,
    };
    this.safeLocalArtifact("append event", () => this.artifactStore?.appendEvent(event));
    await this.sendEvent(event);
  }

  private async sendEvent(event: RegressionEvent): Promise<void> {
    if (!this.apiClient) return;
    try {
      await this.apiClient.sendEvent(event);
    } catch (error) {
      this.logger.warn("CoverIt API", `Could not send regression event "${event.type}". ${(error as Error).message}`);
    }
  }

  private async sendCompletion(summary: RunSummary): Promise<void> {
    if (!this.apiClient) return;
    try {
      await this.apiClient.completeRun(this.identity, summary);
    } catch (error) {
      this.logger.warn("CoverIt API", `Could not send run completion. ${(error as Error).message}`);
    }
  }

  private safeLocalArtifact(operation: string, action: () => void): void {
    try {
      action();
    } catch (error) {
      this.logger.warn("Artifacts", `Could not ${operation}. ${(error as Error).message}`);
    }
  }

  private loadConfigOrFallback(): ReturnType<typeof loadCoveritConfig> {
    try {
      return loadCoveritConfig();
    } catch (error) {
      logger.warn("CoverIt config", `Could not load CoverIt config. Reporting will continue with local defaults. ${(error as Error).message}`);
      return {
        application: { baseUrl: process.env.COVERIT_APP_BASE_URL ?? "http://localhost:3000" },
        run: { name: "Run", applicationId: "", versionId: undefined },
        apiReporting: {
          enabled: false,
          baseUrl: "",
          apiKey: undefined,
          disabledReason: "API reporting disabled: CoverIt config could not be loaded.",
        },
        reporting: {
          localArtifactsEnabled: true,
          artifactRoot: "artifacts",
        },
        healing: { enabled: true, threshold: 0.55 },
      };
    }
  }

  private createApiClient(config: ReturnType<typeof loadCoveritConfig>): CoveritApiClient | undefined {
    if (!config.apiReporting.enabled) return undefined;
    try {
      return new CoveritApiClient(config.apiReporting);
    } catch (error) {
      logger.warn("CoverIt API", `Could not initialize API client. ${(error as Error).message}`);
      return undefined;
    }
  }

  private createArtifactStore(config: ReturnType<typeof loadCoveritConfig>, runId: string): LocalArtifactStore | undefined {
    if (!config.reporting.localArtifactsEnabled) return undefined;
    try {
      return new LocalArtifactStore(config, runId);
    } catch (error) {
      logger.warn("Artifacts", `Could not initialize local artifact store. ${(error as Error).message}`);
      return undefined;
    }
  }

  private getScenarioLogPath(identity: Partial<RunIdentity>): string | undefined {
    if (!this.artifactStore || !identity.scenarioName) return undefined;
    try {
      return this.artifactStore.getScenarioLogPath({
        scenarioName: identity.scenarioName,
        scenarioIndex: identity.scenarioIndex,
        scenarioArtifactName: identity.scenarioArtifactName,
      });
    } catch (error) {
      logger.warn("Artifacts", `Could not resolve scenario log path. ${(error as Error).message}`);
      return undefined;
    }
  }

  private categoryForBddStepType(stepType?: string): "assertion" | "hook" | "designClass" | "basic" {
    const normalized = stepType?.toUpperCase();
    if (normalized === "ASSERTION") return "assertion";
    if (normalized === "ACTION_HOOK") return "hook";
    if (normalized === "DESIGN_CLASS") return "designClass";
    return "basic";
  }

  private titleForAssertionResult(category: string, result: AssertionResult): string {
    const outcome = result.passed ? "passed" : result.severity === "warning" ? "warning" : "failed";
    if (category === "designClass") return `Design class ${outcome}`;
    if (category === "hook") return `Hook ${outcome}`;
    if (category === "assertion") return `Assertion ${outcome}`;
    return `Step ${outcome}`;
  }
}
