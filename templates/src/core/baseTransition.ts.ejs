import { Page } from "@playwright/test";

import { failed, passed } from "@/core/assertionResult";
import { createLocator, resolveLocatorInfo } from "@/core/locatorResolver";
import { HealingEngine } from "@/healing/healingEngine";
import { AssertionResult, HealingContext, HealingResult, TransitionActionInfo, TransitionInfo } from "@/types";

export abstract class BaseTransition {
  readonly id: string;
  readonly label: string;
  readonly className: string;
  readonly actions: TransitionActionInfo[];
  private healingEngine = new HealingEngine();

  protected constructor(readonly definition: TransitionInfo) {
    this.id = definition.id;
    this.label = definition.label;
    this.className = definition.className;
    this.actions = this.normalizeActions(definition);
  }

  injectHealingEngine(healingEngine: HealingEngine): void {
    this.healingEngine = healingEngine;
  }

  async perform(page: Page, context: Partial<HealingContext> = {}): Promise<AssertionResult[]> {
    const results: AssertionResult[] = [];

    if (this.actions.length === 0) {
      results.push(failed("Execute Action", `Transition "${this.id}" has no actions.`));
      return results;
    }

    for (const [index, action] of this.actions.entries()) {
      try {
        const healing = await this.execute(action, page, context);
        results.push(passed(
          this.resultName(index),
          `Executed ${action.type} action ${index + 1}/${this.actions.length} for "${this.id}"`,
          "blocking",
          this.healingInfo(healing),
        ));
      } catch (error) {
        results.push(failed(this.resultName(index), (error as Error).message));
        break;
      }
    }

    return results;
  }

  private async execute(action: TransitionActionInfo, page: Page, context: Partial<HealingContext>): Promise<HealingResult> {
    if (action.type === "navigate") {
      if (!action.url) throw new Error(`Transition "${this.id}" is missing navigation url.`);
      await page.goto(action.url, { waitUntil: "networkidle" });
      return { healed: false, originalSelector: action.url, message: `Navigated to "${action.url}".` };
    }

    const locatorInfo = resolveLocatorInfo(action.locator, action.stateId, action.locatorKey);
    if (!locatorInfo) throw new Error(`Transition "${this.id}" is missing locator information.`);

    const healing = await this.healingEngine.findElement(page, locatorInfo, {
      featureName: context.featureName,
      scenarioName: context.scenarioName,
      stepType: "TRANSITION",
      stepId: this.id,
      stepLabel: this.label,
      action: action.type,
      stateId: action.stateId,
      locatorKey: action.locatorKey,
    });
    const locator = healing.healed && healing.healedSelector
      ? page.locator(healing.healedSelector).first()
      : createLocator(page, locatorInfo).first();

    if (action.type === "click") await locator.click();
    else if (action.type === "fill") await locator.fill(action.value ?? "");
    else if (action.type === "hover") await locator.hover();
    else if (action.type === "select") await locator.selectOption(action.value ?? "");
    else throw new Error(`Unsupported transition action "${action.type}".`);

    await page.waitForLoadState("networkidle").catch(() => undefined);
    return healing;
  }

  private normalizeActions(definition: TransitionInfo): TransitionActionInfo[] {
    if (definition.actions) return definition.actions;
    if (Array.isArray(definition.action)) return definition.action;
    if (definition.action) return [definition.action];
    return [];
  }

  private resultName(index: number): string {
    return this.actions.length === 1 ? "Execute Action" : `Execute Action ${index + 1}`;
  }

  private healingInfo(healing: HealingResult): AssertionResult["healingInfo"] {
    if (!healing.healed) return undefined;
    return {
      wasHealed: true,
      originalSelector: healing.originalSelector,
      healedSelector: healing.healedSelector,
      score: healing.score,
      reason: healing.reason,
      breakdown: healing.breakdown,
    };
  }
}
