import { Page, expect } from "@playwright/test";

import { failed, passed } from "@/core/assertionResult";
import { createLocator, resolveLocatorInfo } from "@/core/locatorResolver";
import { loadCoveritConfig } from "@/config/coveritConfig";
import { DesignClassRuntime } from "@/design/designClassRuntime";
import { HealingEngine } from "@/healing/healingEngine";
import { DESIGN_CLASS_INFO, ASSERTION_INFO } from "@/metadata";
import { Registry } from "@/registry/registry";
import { RunReporter } from "@/reporting/runReporter";
import { AssertionResult, HealingInfo, RegressionRunnerOptions, RunSummary, RuntimeScenarioPlan, RuntimeStepPlan, StepReport } from "@/types";
import { logger, Logger } from "@/utils/logger";

const CALL_STEP = /^call '((?:\\'|[^'])+)'$/;
const ELEMENT_ASSERTION_STEP = /^assert '((?:\\'|[^'])+)'\.([A-Za-z0-9_-]+) ([A-Za-z0-9_-]+)(?: (.+))?$/;
const VARIABLE_ASSERTION_STEP = /^assert \{\{\s*(.+?)\s*\}\} ([A-Za-z0-9_-]+)(?: (.+))?$/;
const ASSIGN_STEP = /^assign (.+) to \{\{\s*(.+?)\s*\}\}$/;
const APPEND_STEP = /^append (.+) to \{\{\s*(.+?)\s*\}\}$/;
const WAIT_STEP = /^wait (\d+)$/;

export class RegressionRunner {
  private readonly runOrigin?: string;
  private readonly featureName?: string;
  private readonly scenarioName?: string;
  private readonly reporter: RunReporter;
  private readonly logger: Logger;
  private readonly healingEngine = new HealingEngine();
  private startedAt = new Date().toISOString();
  private designRuntime = new DesignClassRuntime(DESIGN_CLASS_INFO);

  constructor(private readonly page: Page, options: RegressionRunnerOptions = {}) {
    this.runOrigin = options.runOrigin ?? loadCoveritConfig().application.baseUrl;
    this.featureName = options.featureName;
    this.scenarioName = options.scenarioName;
    this.reporter = options.reporter ?? new RunReporter();
    this.logger = logger.forScenario();
    this.designRuntime.injectHealingEngine(this.healingEngine);
  }

  async runScenario(scenario: RuntimeScenarioPlan): Promise<void> {
    this.startedAt = new Date().toISOString();
    const reports: StepReport[] = [];
    let status: RunSummary["status"] = "passed";
    let scenarioError: unknown;

    this.logger.info("Scenario", `Feature: ${this.featureName ?? "n/a"} | Scenario: ${scenario.name}`);
    await this.reporter.scenarioStatus("running", {
      designClassId: scenario.designClassId,
      designClassStep: scenario.designClassStep,
    });
    await this.log(`SCENARIO START: ${scenario.name}`);
    try {
      if (scenario.designClassId && scenario.designClassId !== DESIGN_CLASS_INFO.id) {
        throw new Error(`Unknown design class "${scenario.designClassId}". Expected "${DESIGN_CLASS_INFO.id}".`);
      }

      for (const step of scenario.steps) {
        if (step.type === "ASSERTION" || step.type === "ACTION_HOOK") continue;

        const report = step.type === "STATE"
          ? await this.runState(step, scenario.steps.filter((candidate) => candidate.type === "ASSERTION" && candidate.parentId === step.id))
          : await this.runTransition(step, scenario.steps.filter((candidate) => candidate.type === "ACTION_HOOK" && candidate.parentId === step.id));
        reports.push(report);
        this.throwOnBlockingFailure(report);
      }
    } catch (error) {
      status = "failed";
      scenarioError = error;
      await this.log(`SCENARIO FAILED: ${scenario.name} -> ${(error as Error).message}`, "error");
      await this.reporter.captureFailureArtifacts(this.page, error);
      await this.reporter.failure({ message: (error as Error).message, stack: (error as Error).stack });
    } finally {
      await this.reporter.scenarioStatus(status, {
        designClassId: scenario.designClassId,
        designClassStep: scenario.designClassStep,
      });
      await this.reporter.saveSummary(this.buildSummary(status, reports));
      await this.logSummary(status, reports);
    }

    if (scenarioError) throw scenarioError;
  }

  private async runState(step: RuntimeStepPlan, assertions: RuntimeStepPlan[]): Promise<StepReport> {
    const state = Registry.resolveState(step.id);
    await this.log(`STATE START: ${state.label} (${state.id})`);
    await this.reporter.stepStatus({ id: state.id, label: state.label, stepType: "STATE", stepText: step.rawText, stepKeyword: step.keyword }, "running");

    const results = step.keyword === "Given"
      ? (await state.setup(this.page, this.runOrigin), await state.assert(this.page, this.runOrigin))
      : await state.assert(this.page, this.runOrigin);

    for (const assertionStep of assertions) results.push(await this.executeAssertion(assertionStep));

    const report = this.report("STATE", state.id, state.label, results, step);
    await this.emitResults(report);
    await this.log(`STATE END: ${state.label} (${report.allPassed ? "passed" : "failed"})`);
    return report;
  }

  private async runTransition(step: RuntimeStepPlan, hooks: RuntimeStepPlan[]): Promise<StepReport> {
    const transition = Registry.resolveTransition(step.id);
    transition.injectHealingEngine(this.healingEngine);
    await this.log(`TRANSITION START: ${transition.label} (${transition.id})`);
    await this.reporter.stepStatus({ id: transition.id, label: transition.label, stepType: "TRANSITION", stepText: step.rawText, stepKeyword: step.keyword }, "running");

    const results: AssertionResult[] = [];
    for (const hook of hooks.filter((candidate) => candidate.hookTiming === "pre")) {
      const result = await this.executeHook(hook);
      results.push(result);
      if (this.hasBlockingFailure([result])) break;
    }

    if (!this.hasBlockingFailure(results)) {
      results.push(...(await transition.perform(this.page, {
        featureName: this.featureName,
        scenarioName: this.scenarioName ?? step.rawText,
      })));
    }

    if (!this.hasBlockingFailure(results)) {
      for (const hook of hooks.filter((candidate) => candidate.hookTiming !== "pre")) {
        const result = await this.executeHook(hook);
        results.push(result);
        if (this.hasBlockingFailure([result])) break;
      }
    }

    const report = this.report("TRANSITION", transition.id, transition.label, results, step);
    await this.emitResults(report);
    await this.log(`TRANSITION END: ${transition.label} (${report.allPassed ? "passed" : "failed"})`);
    return report;
  }

  private async executeAssertion(step: RuntimeStepPlan): Promise<AssertionResult> {
    const stepText = this.stepText(step);
    try {
      this.designRuntime.setHealingContext({
        featureName: this.featureName,
        scenarioName: this.scenarioName,
        stepType: "ASSERTION",
        stepId: step.id,
        stepLabel: stepText,
        stepText: step.rawText,
        stepKeyword: step.keyword,
      });

      const call = stepText.match(CALL_STEP)?.[1]?.replace(/\\'/g, "'");
      if (call) return this.withBddStep(await this.designRuntime.runAssertionFunction(call, this.page), step, call);

      const element = stepText.match(ELEMENT_ASSERTION_STEP);
      if (element) {
        return this.withBddStep(
          await this.assertElementStep(step, {
            alias: element[1].replace(/\\'/g, "'"),
            attribute: element[2],
            assertion: element[3],
            expected: await this.resolveBddValue(element[4], step),
          }),
          step,
          stepText,
        );
      }

      const variable = stepText.match(VARIABLE_ASSERTION_STEP);
      if (variable) {
        const actual = this.designRuntime.store.get(variable[1]);
        const expected = await this.resolveBddValue(variable[3], step);
        const assertion = variable[2];
        const ok = this.compareAssertionValues(assertion, actual, expected);
        return this.withBddStep(
          ok
            ? passed(stepText, `Variable assertion "${assertion}" passed.`)
            : failed(stepText, `Variable assertion "${assertion}" failed. actual=${JSON.stringify(actual)} expected=${JSON.stringify(expected)}`),
          step,
          stepText,
        );
      }

      return this.withBddStep(failed("Assertion", `Unsupported assertion step "${stepText}".`), step, "Assertion");
    } catch (error) {
      return this.withBddStep(failed(stepText, (error as Error).message), step, stepText);
    }
  }

  private async executeHook(step: RuntimeStepPlan): Promise<AssertionResult> {
    const stepText = this.stepText(step);
    try {
      this.designRuntime.setHealingContext({
        featureName: this.featureName,
        scenarioName: this.scenarioName,
        stepType: "ACTION_HOOK",
        stepId: step.id,
        stepLabel: stepText,
        stepText: step.rawText,
        stepKeyword: step.keyword,
      });

      const wait = stepText.match(WAIT_STEP);
      if (wait) {
        await this.page.waitForTimeout(Number(wait[1]));
        return this.withBddStep(passed(stepText, `Waited ${wait[1]}ms.`), step, stepText);
      }

      if (stepText === "refresh" || stepText === "reload") {
        await this.page.reload({ waitUntil: "networkidle" });
        return this.withBddStep(passed(stepText, "Reloaded page."), step, stepText);
      }

      const call = stepText.match(CALL_STEP)?.[1]?.replace(/\\'/g, "'");
      if (call) return this.withBddStep(await this.designRuntime.runDesignFunction(call, this.page), step, call);

      const assign = stepText.match(ASSIGN_STEP);
      if (assign) {
        this.designRuntime.store.set(assign[2], await this.resolveBddValue(assign[1], step));
        return this.withBddStep(passed(stepText, `Assigned "${assign[2]}".`), step, stepText);
      }

      const append = stepText.match(APPEND_STEP);
      if (append) {
        this.designRuntime.store.append(append[2], await this.resolveBddValue(append[1], step));
        return this.withBddStep(passed(stepText, `Appended "${append[2]}".`), step, stepText);
      }

      return this.withBddStep(failed("Action Hook", `Unsupported action step "${stepText}".`), step, "Action Hook");
    } catch (error) {
      return this.withBddStep(failed(stepText, (error as Error).message), step, stepText);
    }
  }

  private async assertElementStep(
    step: RuntimeStepPlan,
    parsed: { alias: string; attribute: string; assertion: string; expected: unknown },
  ): Promise<AssertionResult> {
    const stateId = step.contextId ?? step.parentId;
    const locatorInfo = resolveLocatorInfo(undefined, stateId, parsed.alias);
    if (!locatorInfo || !stateId) throw new Error(`Element alias "${parsed.alias}" is not mapped for this state.`);

    const healing = await this.healingEngine.findElement(this.page, locatorInfo, {
      featureName: this.featureName,
      scenarioName: this.scenarioName,
      stepType: "ASSERTION",
      stepId: step.id,
      stepLabel: parsed.alias,
      stepText: step.rawText,
      stepKeyword: step.keyword,
      action: parsed.assertion,
      stateId,
      locatorKey: parsed.alias,
    });
    const locator = healing.healed && healing.healedSelector
      ? this.page.locator(healing.healedSelector).first()
      : createLocator(this.page, locatorInfo).first();

    const expected = parsed.expected;
    if (parsed.assertion === "visibility") await expect(locator).toBeVisible();
    else if (parsed.assertion === "text") await expect(locator).toContainText(String(expected ?? ""));
    else if (parsed.assertion === "text-exact") await expect(locator).toHaveText(String(expected ?? ""));
    else if (parsed.assertion === "text-matches") await expect(locator).toHaveText(new RegExp(String(expected ?? "")));
    else if (parsed.assertion === "value") await expect(locator).toHaveValue(String(expected ?? ""));
    else if (parsed.assertion === "attribute") await expect(locator).toHaveAttribute(parsed.attribute, String(expected ?? ""));
    else if (parsed.assertion === "count") await expect(locator).toHaveCount(this.toNumber(expected, 0));
    else if (parsed.assertion === "exists") {
      const count = await locator.count();
      if (count < 1) throw new Error(`Expected element alias "${parsed.alias}" to exist.`);
    } else {
      throw new Error(`Unsupported element assertion "${parsed.assertion}".`);
    }

    return passed(parsed.alias, `Element assertion "${parsed.assertion}" passed.`, "blocking", this.toHealingInfo(healing));
  }

  private compareAssertionValues(assertion: string, actual: unknown, expected: unknown): boolean {
    if (assertion === "exists") return actual !== undefined && actual !== null;
    if (assertion === "visibility") return Boolean(actual) === true;
    if (assertion === "text") return String(actual ?? "").includes(String(expected ?? ""));
    if (assertion === "text-matches") return new RegExp(String(expected ?? "")).test(String(actual ?? ""));
    if (assertion === "count") return this.toNumber(Array.isArray(actual) ? actual.length : actual, Number.NaN) === this.toNumber(expected, Number.NaN);
    if (assertion === "enabled" || assertion === "checked") return actual === true;
    if (assertion === "disabled" || assertion === "unchecked") return actual === false;
    return String(actual ?? "") === String(expected ?? "");
  }

  private async resolveBddValue(rawValue: string | undefined, step: RuntimeStepPlan): Promise<unknown> {
    if (!rawValue) return undefined;
    const value = rawValue.trim();

    const element = value.match(/^'((?:\\'|[^'])+)'\.([A-Za-z0-9_-]+)$/);
    if (element) return this.readAliasedElementValue(element[1].replace(/\\'/g, "'"), element[2], step.contextId);

    const variable = value.match(/^\{\{\s*(.+?)\s*\}\}$/);
    if (variable) return this.designRuntime.store.get(variable[1]);

    const quotedVariable = value.match(/^'\{\{\s*(.+?)\s*\}\}'$/);
    if (quotedVariable) return this.designRuntime.store.get(quotedVariable[1]);

    return this.parseBddValue(value);
  }

  private parseBddValue(rawValue: string | undefined): unknown {
    if (!rawValue) return undefined;
    const value = rawValue.trim();
    const quoted = value.match(/^'((?:\\'|[^'])*)'$/);
    if (quoted) return quoted[1].replace(/\\'/g, "'");
    if (value === "true") return true;
    if (value === "false") return false;
    if (value === "null") return null;
    const number = Number(value);
    if (value && Number.isFinite(number)) return number;
    return value;
  }

  private async readAliasedElementValue(alias: string, attribute: string, stateId?: string): Promise<unknown> {
    const locatorInfo = resolveLocatorInfo(undefined, stateId, alias);
    if (!locatorInfo || !stateId) throw new Error(`Element alias "${alias}" is not mapped for this state.`);
    const locator = createLocator(this.page, locatorInfo).first();
    if (attribute === "text") return locator.textContent();
    if (attribute === "value") return locator.inputValue();
    return locator.getAttribute(attribute);
  }

  private stepText(step: RuntimeStepPlan): string {
    return step.rawText.replace(/^(Given|When|Then|And|But)\s+/, "").trim();
  }

  private toNumber(value: unknown, fallback: number): number {
    const parsed = Number(value);
    return Number.isFinite(parsed) ? parsed : fallback;
  }

  private report(stepType: string, id: string, label: string, results: AssertionResult[], step: RuntimeStepPlan): StepReport {
    return {
      stepType,
      id,
      label,
      stepText: step.rawText,
      stepKeyword: step.keyword,
      results,
      allPassed: results.filter((result) => result.severity === "blocking").every((result) => result.passed),
    };
  }

  private withBddStep(result: AssertionResult, step: RuntimeStepPlan, label?: string, category?: AssertionResult["category"]): AssertionResult {
    const semanticCategory = category ?? this.categoryForBddStep(step);
    return {
      ...result,
      category: semanticCategory,
      bddStep: {
        type: step.type,
        id: step.id,
        label,
        keyword: step.keyword,
        text: step.rawText,
      },
    };
  }

  private categoryForBddStep(step: RuntimeStepPlan): AssertionResult["category"] {
    if (step.type === "ASSERTION") return "assertion";
    if (step.type === "ACTION_HOOK") return this.categoryForActionStep(this.stepText(step));
    return undefined;
  }

  private categoryForActionStep(stepText: string): AssertionResult["category"] {
    if (/^(?:assign|append|prepend|merge|remove|pop|increment|decrement|toggle|delete|put|call)\b/.test(stepText)) return "designClass";
    return "hook";
  }

  private hasBlockingFailure(results: AssertionResult[]): boolean {
    return results.some((result) => !result.passed && result.severity === "blocking");
  }

  private async emitResults(report: StepReport): Promise<void> {
    for (const result of report.results) {
      await this.logResult(result);
      await this.reporter.assertionResult(report, result);
    }
    await this.reporter.stepStatus(report, report.allPassed ? "passed" : "failed");
  }

  private throwOnBlockingFailure(report: StepReport): void {
    const failure = report.results.find((result) => !result.passed && result.severity === "blocking");
    if (failure) throw new Error(`[FAIL] ${report.label} -> ${failure.name}: ${failure.message}`);
  }

  private buildSummary(status: RunSummary["status"], reports: StepReport[]): RunSummary {
    const finishedAt = new Date().toISOString();
    const results = reports.flatMap((report) => report.results);
    return {
      status,
      startedAt: this.startedAt,
      finishedAt,
      durationMs: new Date(finishedAt).getTime() - new Date(this.startedAt).getTime(),
      totals: {
        passed: results.filter((result) => result.passed).length,
        failed: results.filter((result) => !result.passed && result.severity === "blocking").length,
        warnings: results.filter((result) => result.healingInfo?.wasHealed || (!result.passed && result.severity !== "blocking")).length,
      },
      reports,
    };
  }

  private toHealingInfo(healing: { healed: boolean; originalSelector: string; healedSelector?: string; score?: number; reason?: string; breakdown?: Record<string, number> }): HealingInfo | undefined {
    if (!healing.healed) return undefined;
    return {
      wasHealed: true,
      originalSelector: healing.originalSelector,
      healedSelector: healing.healedSelector,
      score: healing.score,
      reason: healing.reason,
      breakdown: healing.breakdown,
    };
  }

  private async logResult(result: AssertionResult): Promise<void> {
    const status = result.passed ? "PASS" : result.severity === "blocking" ? "FAIL" : "WARN";
    await this.log(`${status}: [${result.severity}] ${result.name} - ${result.message}`, result.passed ? "info" : result.severity === "blocking" ? "error" : "warning");
    if (result.healingInfo?.wasHealed) {
      await this.log(`HEALED: "${result.healingInfo.originalSelector}" -> "${result.healingInfo.healedSelector}" score=${result.healingInfo.score?.toFixed(3) ?? "n/a"}`, "warning");
      await this.log("Update mapping selector manually if this healing is accepted.", "warning");
    }
  }

  private async logSummary(status: RunSummary["status"], reports: StepReport[]): Promise<void> {
    const summary = this.buildSummary(status, reports);
    const healed = reports.flatMap((report) => report.results).filter((result) => result.healingInfo?.wasHealed);
    await this.log(`SCENARIO END: ${status}. passed=${summary.totals.passed}, failed=${summary.totals.failed}, warnings=${summary.totals.warnings}, healed=${healed.length}`);
  }

  private async log(message: string, level: "info" | "warning" | "error" = "info"): Promise<void> {
    if (level === "error") this.logger.error("Runner", message);
    else if (level === "warning") this.logger.warn("Runner", message);
    else this.logger.info("Runner", message);
    await this.reporter.log(message, level);
  }
}
