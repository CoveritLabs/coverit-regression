{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@generator/*": [
        "src/generator/*"
      ],
      "@constants/*": [
        "src/constants/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@input/*": [
        "src/input/*"
      ],
      "@planner/*": [
        "src/planner/*"
      ],
      "@workflow/*": [
        "src/workflow/*"
      ]
    }
  },
  "include": ["src/**/*"],
}
