FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=development

RUN apk add --no-cache ca-certificates git

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
  && npm pkg delete "devDependencies.@coveritlabs/git-hooks" \
  && npm install --no-save --package-lock=false --ignore-scripts \
    typescript@6.0.3 \
    tsc-alias@1.8.17 \
    nodemon@3.1.10 \
    @types/ejs@3.1.5 \
    @types/js-yaml@4.0.9 \
    @types/node@25.9.3 \
    @types/pg@8.20.0

COPY tsconfig.json config.yaml ./
COPY src ./src
COPY templates ./templates

RUN mkdir -p input logs output tmp \
  && chown -R node:node /app

USER node

CMD ["./node_modules/.bin/nodemon", "--legacy-watch", "--watch", "src", "--watch", "templates", "--watch", "config.yaml", "--watch", "tsconfig.json", "--ext", "ts,ejs,yaml,json", "--signal", "SIGTERM", "--exec", "npm run worker"]
