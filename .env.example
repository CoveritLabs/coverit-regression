# CoverIt regression worker environment
# Copy to .env when running the worker locally.

LOG_LEVEL=info

# Worker against Docker infrastructure exposed on the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/coverit
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Compose defaults for the worker container on the Docker network.
REGRESSION_DATABASE_URL=postgresql://postgres:postgres@db:5432/coverit
REGRESSION_REDIS_HOST=redis
REGRESSION_REDIS_PORT=6379
REGRESSION_REDIS_PASSWORD=

# API notifications. Must match coverit-api INTERNAL_SERVICE_TOKEN.
COVERIT_API_INTERNAL_URL=http://localhost:3000
COVERIT_API_BASE_URL=http://localhost:3000
INTERNAL_SERVICE_TOKEN=change-me-for-internal-services

# Worker behavior.
WORKER_CONCURRENCY=1
REGRESSION_TAG=dev
REGRESSION_OUTPUT_CLEANUP_ENABLED=true
REGRESSION_OUTPUT_CLEANUP_INTERVAL_MS=900000
REGRESSION_OUTPUT_MAX_AGE_MS=7200000
